# Copy this file to .env and fill in what you have. Every key is optional:
# the app runs without them and simply hides the feature that needs one.

PORT=3000

# Contact info sent in the User-Agent to public APIs (Transitous asks for this).
# Use a website or an email address you are happy to share with API operators.
CONTACT=

# Routing / geocoding / schedules. Default is the free community Transitous API
# (open-source, NON-COMMERCIAL use only, ~720 trip plans per day).
# For a commercial or high-traffic launch, self-host MOTIS (same API) and point this at it.
MOTIS_URL=https://api.transitous.org

# GO Transit + UP Express live data. Free key: register at
# https://api.openmetrolinx.com/OpenDataAPI/Help/Registration/en
METROLINX_API_KEY=

# Pearson (YYZ) live arrivals/departures via AeroDataBox on RapidAPI.
# Free "Basic" plan available: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_RAPIDAPI_KEY=

# Optional: pin Web Push keys (otherwise auto-generated into data/push.json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Place search (shops, gyms, intersections). Default: free public Photon server (fair use).
# For heavy traffic, self-host Photon and point this at it.
PHOTON_URL=https://photon.komoot.io
